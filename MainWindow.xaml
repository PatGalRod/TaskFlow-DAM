<Window x:Class="DAM2_DI_UD03_P01_Patrick_Galan.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:DAM2_DI_UD03_P01_Patrick_Galan"
        xmlns:vm="clr-namespace:DAM2_DI_UD03_P01_Patrick_Galan.ViewModels"
        xmlns:conv="clr-namespace:DAM2_DI_UD03_P01_Patrick_Galan.Converters"
        mc:Ignorable="d"
        Title="TaskFlow DAM" Height="680" Width="850" MinHeight="500" MinWidth="650"
        WindowStartupLocation="CenterScreen">
        
    <Window.Resources>
        <conv:PrioridadConverter x:Key="PrioridadConv"/>
        <SolidColorBrush x:Key="WindowBackground" Color="#F5F5F5"/>
        <SolidColorBrush x:Key="PrimaryText" Color="#212121"/>
        <SolidColorBrush x:Key="AccentColor" Color="#1A237E"/>

        <SolidColorBrush x:Key="ModuleBadgeBackground" Color="#E3F2FD"/>
        <SolidColorBrush x:Key="ModuleBadgeText" Color="#0D47A1"/>

        <SolidColorBrush x:Key="LowPriorityBackground" Color="#E8F5E9"/>
        <SolidColorBrush x:Key="LowPriorityText" Color="#1B5E20"/>
        <SolidColorBrush x:Key="MediumPriorityBackground" Color="#FFF3E0"/>
        <SolidColorBrush x:Key="MediumPriorityText" Color="#BF360C"/>
        <SolidColorBrush x:Key="HighPriorityBackground" Color="#FFEBEE"/>
        <SolidColorBrush x:Key="HighPriorityText" Color="#B71C1C"/>

        <SolidColorBrush x:Key="AddButtonBackground" Color="#1A237E"/>
        <SolidColorBrush x:Key="AddButtonForeground" Color="#FFFFFF"/>

        <SolidColorBrush x:Key="ADModuleBackGround" Color="#E0F2F1"/>
        <SolidColorBrush x:Key="ADModuleForeground" Color="#004D40"/>
        <SolidColorBrush x:Key="PSPModuleBackGround" Color="#FFF8E1"/>
        <SolidColorBrush x:Key="PSPModuleForeground" Color="#5D4037"/>
        <SolidColorBrush x:Key="PMDMModuleBackGround" Color="#FCE4EC"/>
        <SolidColorBrush x:Key="PMDMModuleForeground" Color="#880E4F"/>
        <SolidColorBrush x:Key="EIEModuleBackGround" Color="#EFEBE9"/>
        <SolidColorBrush x:Key="EIEModuleForeground" Color="#3E2723"/>
        <SolidColorBrush x:Key="SgeModuleBackground" Color="#F3E5F5"/>
        <SolidColorBrush x:Key="SgeMoxuleForeground" Color="#4A148C"/>

        <Style x:Key="AddButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource AddButtonBackground}"/>
            <Setter Property="Foreground" Value="{StaticResource AddButtonForeground}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                        BorderBrush="Transparent" BorderThickness="2" CornerRadius="4"
                        Padding="16,4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#FFB300"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Background" Value="#E0E0E0"/>
                                <Setter Property="Foreground" Value="#424242"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </Window.Resources>
    <Window.DataContext>
        <vm:MainViewModel/>
    </Window.DataContext>

    <DockPanel Background="{StaticResource WindowBackground}" TextElement.Foreground="{StaticResource PrimaryText}">
        <StatusBar DockPanel.Dock="Bottom">
            <StatusBarItem DockPanel.Dock="Right" Margin="0, 0, 14, 0">
                <TextBlock  Text="{Binding TextoPendientes}" VerticalAlignment="Center"/>
            </StatusBarItem>
            <StatusBarItem >
                <TextBlock Text="{Binding EstadoApp}" Margin="14, 0, 0, 0" VerticalAlignment="Center"/>
            </StatusBarItem>
        </StatusBar>
        <Grid Margin="15">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <GroupBox Header="+ Nueva tarea" Grid.Row="0" Padding="10">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Label VerticalAlignment="Center" Grid.Row="0" Grid.Column="0" Content="_Título:" Target="{Binding ElementName=TxtTitulo}"/>
                    <TextBox x:Name="TxtTitulo" AutomationProperties.Name="Título de la tarea" 
                        AutomationProperties.HelpText="Introduzca el título con el que desea registrar la tarea" Grid.Row="0" Grid.Column="1" 
                        Grid.ColumnSpan="3" Margin="10" TabIndex="0"
                        Text="{Binding NuevoTitulo, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>

                    <Label VerticalAlignment="Center" Grid.Row="1" Grid.Column="0" Content="_Módulo:" Target="{Binding ElementName=CmbModulo}"/>
                    <ComboBox x:Name="CmbModulo" AutomationProperties.Name="Selector de módulo educativo" 
                        AutomationProperties.HelpText="Seleccione entre Desarrollo de interfaces, Sistemas de gestión empresarial, Acceso a datos, 
                              Programación de servicios y procesos, Programación multimedia y dispositivos moviles e Itinerario personal para la empleabilidad" 
                        Grid.Row="1" Grid.Column="1" Margin="10" ItemsSource="{Binding Modulos}" TabIndex="1"
                        SelectedItem="{Binding NuevoModulo, Mode=TwoWay}"/>

                    <Label VerticalAlignment="Center" Grid.Row="1" Grid.Column="2" Content="_Fecha límite:" Target="{Binding ElementName=DateFecha}"/>
                    <DatePicker x:Name="DateFecha" AutomationProperties.Name="Fecha de entrega" 
                        AutomationProperties.HelpText="Introduzca fecha limite para la entrega de la tarea" Grid.Row="1" Grid.Column="3" Margin="10" TabIndex="2"
                        SelectedDate="{Binding NuevaFecha, Mode=TwoWay}"/>

                    <Label VerticalAlignment="Center" Grid.Row="2" Grid.Column="0" Content="_Prioridad:" Target="{Binding ElementName=RbBaja}"/>
                    <StackPanel VerticalAlignment="Center" Orientation="Horizontal" Grid.Row="2" Grid.Column="1" Margin="10" >
                        <RadioButton x:Name="RbBaja" AutomationProperties.Name="Prioridad baja" 
                            AutomationProperties.HelpText="Establece la prioridad en baja" Margin="0,0,15,0" Content="_Baja" GroupName="GrpPrioridad" TabIndex="3"
                            IsChecked="{Binding NuevaPrioridad, Mode=TwoWay, Converter={StaticResource PrioridadConv}, ConverterParameter=Baja}"/>
                        <RadioButton Content="Me_dia" AutomationProperties.Name="Prioridad media" 
                            AutomationProperties.HelpText="Establece la prioridad en media" Margin="0,0,15,0" GroupName="GrpPrioridad" TabIndex="4"
                            IsChecked="{Binding NuevaPrioridad, Mode=TwoWay, Converter={StaticResource PrioridadConv} , ConverterParameter=Media}"/>
                        <RadioButton Content="_Alta" AutomationProperties.Name="Prioridad alta" 
                            AutomationProperties.HelpText="Establece la prioridad en alta" Margin="0,0,15,0" GroupName="GrpPrioridad" TabIndex="5"
                            IsChecked="{Binding NuevaPrioridad, Mode=TwoWay, Converter={StaticResource PrioridadConv} , ConverterParameter=Alta}"/>
                        <CheckBox Content="_Urgente" AutomationProperties.Name="Urgente" 
                            AutomationProperties.HelpText="Defina si la tarea es Urgente" Margin="0,0,15,0" IsChecked="{Binding NuevoEsUrgente, Mode=TwoWay}" TabIndex="6"/>
                    </StackPanel>
                    <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Left" Grid.ColumnSpan="4">
                        <Button Content="_Limpiar" x:Name="BtLimpiar" AutomationProperties.Name="Limpiar formulario" 
                                AutomationProperties.HelpText="Pulse tecla esc para limpiar" Height="40" Margin="10" Padding="10" IsCancel="True" 
                                Click="BtLimpiar_Click" TabIndex="8" />
                        <Button Content="A_ñadir" x:Name="BtAnadir" Style="{StaticResource AddButtonStyle}" AutomationProperties.Name="Añadir tarea"
                            AutomationProperties.HelpText="Pulse intro para confirmar y añadir una nueva tarea" Height="40" Margin="10" IsDefault="True" Click="BtAnadir_Click"
                            IsEnabled="{Binding TituloValido}" TabIndex="7"/>
                    </StackPanel>
                </Grid>
            </GroupBox>
            <Border Grid.Row="1" BorderThickness="1" BorderBrush="Black" Padding="10" Margin="0,15">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="PROGRESO DEL DÍA:" VerticalAlignment="Center"/>
                    <ProgressBar  Grid.Column="1" Foreground="{StaticResource AccentColor}" AutomationProperties.Name="Barra de progreso" 
                        AutomationProperties.HelpText="{Binding ProgresoPorcentaje, StringFormat='El porcentaje actual es de: {0}%'}" 
                        Height="20" Minimum="0" Maximum="100" Margin="10" Value="{Binding ProgresoPorcentaje, Mode=OneWay}"/>
                    <TextBlock Grid.Column="2" Text="{Binding TextoProgreso}" VerticalAlignment="Center"/>
                </Grid>
            </Border>
            <DockPanel Grid.Row="2">
                <Label DockPanel.Dock="Top"  Content="LISTADO DE TAREAS"/>
                <ListBox x:Name="LstTareas" AutomationProperties.Name="Listado de tareas" KeyboardNavigation.TabNavigation="Continue" 
                    AutomationProperties.HelpText="Aquí se listan todas las tareas completadas o no" ItemsSource="{Binding Tareas}" 
                    SelectionChanged="LstTareas_SelectionChanged">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="AutomationProperties.Name" Value="{Binding Titulo}"/>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            
                            <Grid >
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <CheckBox Grid.Column="0" VerticalAlignment="Center" AutomationProperties.Name="{Binding Titulo, StringFormat='Tarea: {0}'}" 
                                    AutomationProperties.HelpText="Defina si la tarea está acabada o no" IsChecked="{Binding Completada, Mode=TwoWay}" Margin="2"/>
                                <TextBlock x:Name="TxtTituloTarea" Grid.Column="1" Text="{Binding Titulo}" Margin="10,0" VerticalAlignment="Center"/>

                                <Border Grid.Column="2" Margin="10, 0" ToolTip="Desarrollo de Interfaces" CornerRadius="4" x:Name="BrdModule" Background="{StaticResource ModuleBadgeBackground}" >
                                    <TextBlock VerticalAlignment="Center" Padding="8,3" Text="{Binding Modulo}" x:Name="TxtModule" 
                                         Foreground="{StaticResource ModuleBadgeText}" FontWeight="SemiBold"/>
                                </Border>
                                <Border x:Name="BrdPriority" Grid.Column="3" Margin="10,0" CornerRadius="4" Background="{StaticResource LowPriorityBackground}" 
                                    ToolTip="Prioridad Baja: sin fecha de entrega cercana.">
                                    <TextBlock x:Name="TxtPriority" VerticalAlignment="Center" Padding="8,3" Text="{Binding Prioridad}" 
                                        Foreground="{StaticResource LowPriorityText}" FontWeight="SemiBold"/>
                                </Border>
                                <Button Grid.Column="4" MinHeight="36" MinWidth="36" AutomationProperties.Name="{Binding Titulo, StringFormat='Borra la tarea: {0}'}" 
                                    AutomationProperties.HelpText="Quita una tarea de la lista" Content="🗑" Click="BtEliminar_Click" Margin="10,0"/>
                            </Grid>
                            <DataTemplate.Triggers >
                                <DataTrigger Binding="{Binding Completada}" Value="true">
                                    <Setter TargetName="TxtTituloTarea" Property="TextDecorations" Value="Strikethrough"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Prioridad}" Value="Media">
                                    <Setter TargetName="BrdPriority" Property="Background" Value="{StaticResource MediumPriorityBackground}"/>
                                    <Setter TargetName="TxtPriority" Property="Foreground" Value="{StaticResource MediumPriorityText}"/>
                                    <Setter TargetName="BrdPriority" Property="ToolTip" Value="Prioridad Media: conviene planificarla."/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Prioridad}" Value="Alta">
                                    <Setter TargetName="BrdPriority" Property="Background" Value="{StaticResource HighPriorityBackground}"/>
                                    <Setter TargetName="BrdPriority" Property="ToolTip" Value="Prioridad Alta: hay que hacerla cuanto antes."/>        
                                    <Setter TargetName="TxtPriority" Property="Foreground" Value="{StaticResource HighPriorityText}"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Modulo}" Value="AD">
                                    <Setter TargetName="BrdModule" Property="Background" Value="{StaticResource ADModuleBackGround}"/>
                                    <Setter TargetName="TxtModule" Property="Foreground" Value="{StaticResource ADModuleForeground}"/>
                                    <Setter TargetName="BrdModule" Property="ToolTip" Value="Modulo: Acceso a Datos"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Modulo}" Value="PSP">
                                    <Setter TargetName="BrdModule" Property="Background" Value="{StaticResource PSPModuleBackGround}"/>
                                    <Setter TargetName="TxtModule" Property="Foreground" Value="{StaticResource PSPModuleForeground}"/>
                                    <Setter TargetName="BrdModule" Property="ToolTip" Value="Modulo: Programación de servicios y procesos"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Modulo}" Value="SGE">
                                    <Setter TargetName="BrdModule" Property="Background" Value="{StaticResource SgeModuleBackground}"/>
                                    <Setter TargetName="TxtModule" Property="Foreground" Value="{StaticResource SgeMoxuleForeground}"/>
                                    <Setter TargetName="BrdModule" Property="ToolTip" Value="Modulo: Sistemas de gestión empresarial"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Modulo}" Value="PMDM">
                                    <Setter TargetName="BrdModule" Property="Background" Value="{StaticResource PMDMModuleBackGround}"/>
                                    <Setter TargetName="TxtModule" Property="Foreground" Value="{StaticResource PMDMModuleForeground}"/>
                                    <Setter TargetName="BrdModule" Property="ToolTip" Value="Modulo: Programación multimedia y dispositivos moviles"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Modulo}" Value="EIE">
                                    <Setter TargetName="BrdModule" Property="Background" Value="{StaticResource EIEModuleBackGround}"/>
                                    <Setter TargetName="TxtModule" Property="Foreground" Value="{StaticResource EIEModuleForeground}"/>
                                    <Setter TargetName="BrdModule" Property="ToolTip" Value="Modulo: Empresa e Iniciativa emprendedora"/>
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Grid>
    </DockPanel>

</Window>
